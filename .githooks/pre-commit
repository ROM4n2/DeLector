#!/usr/bin/env bash
# Repository Pre-Commit Hook: secret scan, container magic, EOL check, and repo gates.
# repo-hook-version: 7
set -u

# Chain adopted project hook if present
SELF_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd -P)"
ADOPTED="$SELF_DIR/$(basename "$0").adopted"
if [ -f "$ADOPTED" ] && [ -x "$ADOPTED" ]; then
    if ! "$ADOPTED" "$@"; then
        printf '[CHAIN] adopted hook failed: %s\n' "$ADOPTED" >&2
        exit 1
    fi
fi

PRAGMA='git:allow-secret'

PATTERNS='OpenAI/Anthropic key|sk-[A-Za-z0-9]{20,}
AWS Access Key ID|AKIA[A-Z0-9]{16}
GitHub PAT (classic)|ghp_[A-Za-z0-9]{36}
GitHub PAT (fine-grained)|github_pat_[A-Za-z0-9_]{20,}
Google API Key|AIza[A-Za-z0-9_-]{30,}
Slack token|xox[baprs]-[A-Za-z0-9-]{10,}
JWT|eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}
PEM private key|-----BEGIN [A-Z ]*PRIVATE KEY-----'

GREP_ARGS=()
while IFS='|' read -r _label regex; do
    [ -n "${regex:-}" ] || continue
    GREP_ARGS+=(-e "$regex")
done <<< "$PATTERNS"

STAGED="$(git diff --cached --name-only --diff-filter=ACMR)"

NAME_HITS=""
while IFS= read -r path; do
    [ -n "$path" ] || continue
    case "$path" in
        *.example|*.sample|*.template) continue ;;
    esac
    case "$path" in
        .env|*/.env|*.secret|*credentials*|*.pem|*.key|*id_rsa*|*id_ed25519*|\
        *.jks|*.jks.b64|*.keystore|*.p12|*.pfx|*signing.properties|*keystore.properties)
            NAME_HITS="${NAME_HITS}${path}"$'\n'
            ;;
    esac
done <<< "$STAGED"

CONTENT_HITS=""
if [ "${#GREP_ARGS[@]}" -gt 0 ]; then
    CONTENT_HITS="$(git grep --cached -nIE "${GREP_ARGS[@]}" 2>/dev/null | grep -vF -- "$PRAGMA" || true)"
fi

MAGIC_HITS=""
while IFS= read -r path; do
    [ -n "$path" ] || continue
    case "$path" in
        *.jks|*.jks.b64|*.keystore|*.p12|*.pfx|*.der|*.cer|*.p8|*.b64|*.dat|*.bin|*.key|*.pem) ;;
        *) continue ;;
    esac
    [ -f "$path" ] || continue
    magic="$(head -c 8 "$path" 2>/dev/null | od -An -tx1 | tr -d ' \n')"
    case "$magic" in
        feedfeed*)         magic_label="Java KeyStore (magic 0xFEEDFEED)" ;;
        cececece*)         magic_label="Java KeyStore (magic 0xCECECECE)" ;;
        3080*|3081*|3082*) magic_label="DER / PKCS#12 container" ;;
        2d2d2d2d2d)        magic_label="PEM private key" ;;
        *) continue ;;
    esac
    MAGIC_HITS="${MAGIC_HITS}${path}|${magic_label}"$'\n'
done <<< "$STAGED"

EOL_CANDIDATES=""
while IFS= read -r path; do
    [ -n "$path" ] || continue
    case "$path" in
        .githooks/*|*.sh|*.bash) EOL_CANDIDATES="${EOL_CANDIDATES}${path}"$'\n' ;;
    esac
done <<< "$STAGED"

LF_PINNED=""
if [ -n "$EOL_CANDIDATES" ]; then
    LF_PINNED="$(
        while IFS= read -r p; do
            [ -n "$p" ] && printf '%s\0' "$p"
        done <<< "$EOL_CANDIDATES" \
        | git check-attr --stdin -z eol 2>/dev/null \
        | while IFS= read -r -d '' p && IFS= read -r -d '' _attr && IFS= read -r -d '' value; do
              [ "$value" = "lf" ] && printf '%s\n' "$p"
          done
    )"
fi

EOL_HITS=""
while IFS= read -r path; do
    [ -n "$path" ] || continue
    case "$path" in
        .githooks/*) ;;
        *)
            case $'\n'"$LF_PINNED"$'\n' in
                *$'\n'"$path"$'\n'*) ;;
                *) continue ;;
            esac
            ;;
    esac
    if [ -f "$path" ] && [ "$(tr -cd '\r' < "$path" | wc -c)" -gt 0 ]; then
        EOL_HITS="${EOL_HITS}${path}"$'\n'
    fi
done <<< "$STAGED"

if [ -n "$NAME_HITS" ] || [ -n "$MAGIC_HITS" ] || [ -n "$CONTENT_HITS" ] || [ -n "$EOL_HITS" ]; then
    echo "[SECURITY ALERT] Sensitive file, credential, or non-executable hook detected; commit blocked:" >&2
    if [ -n "$NAME_HITS" ]; then
        while IFS= read -r path; do
            [ -n "$path" ] && printf '  - [NAME] %s (sensitive file must not be committed)\n' "$path" >&2
        done <<< "$NAME_HITS"
    fi
    if [ -n "$MAGIC_HITS" ]; then
        while IFS='|' read -r path magic_label; do
            [ -n "$path" ] && printf '  - [MAGIC] %s (%s)\n' "$path" "$magic_label" >&2
        done <<< "$MAGIC_HITS"
    fi
    if [ -n "$EOL_HITS" ]; then
        while IFS= read -r path; do
            [ -n "$path" ] && printf '  - [EOL] %s (CRLF in worktree breaks execution; normalize to LF)\n' "$path" >&2
        done <<< "$EOL_HITS"
    fi
    if [ -n "$CONTENT_HITS" ]; then
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            printf '  - [LINE] %s\n' "$line" >&2
        done <<< "$CONTENT_HITS"
    fi
    echo "Remove sensitive data or annotate verified false positives with: # $PRAGMA" >&2
    exit 1
fi

PY_BIN=""
if [ -x ".venv/Scripts/python.exe" ]; then
    PY_BIN=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ]; then
    PY_BIN=".venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PY_BIN="python3"
elif command -v python >/dev/null 2>&1; then
    PY_BIN="python"
fi
[ -n "$PY_BIN" ] || exit 0

LOG_DIR="$(mktemp -d)"
trap 'rm -rf "$LOG_DIR"' EXIT
PIDS=()
LABELS=()

launch() {
    local label="$1"; shift
    "$@" > "$LOG_DIR/$label.log" 2>&1 &
    PIDS+=($!)
    LABELS+=("$label")
}

[ -f "scripts/check_repo_hygiene.py" ] && \
    launch hygiene "$PY_BIN" -B scripts/check_repo_hygiene.py --staged

if [ -f "scripts/check_repo_structure.py" ] && \
   [ -n "$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')" ]; then
    launch structure "$PY_BIN" -B scripts/check_repo_structure.py
fi

FAILED=0
for i in "${!PIDS[@]}"; do
    if ! wait "${PIDS[$i]}"; then
        cat "$LOG_DIR/${LABELS[$i]}.log" >&2
        FAILED=1
    fi
done

exit "$FAILED"
