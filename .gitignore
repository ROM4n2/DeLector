__pycache__/
*.pyc

# 敏感配置与密钥（通用基线，与 bootstrap.ps1 $requiredIgnores 同步）
config.yaml
config.yml
config.local.yaml
.env.*
*.pem
*.key
*.local.json
credentials.json

.env
*.env
*.secret
*.db
*.db-shm
*.db-wal
*.db-journal
*.apkg
*.apk
artifact*.html
.pytest_cache/
.cache/
build/
dist/
*.spec
.gradle/
android/app/src/main/python/
android/app/src/main/assets/static/


# AI 批量生成词库的批次缓存（tools/build_dict.py）
tools/raw/
tools/raw_prep/
tools/raw_refill/
tools/raw_embedded/

# 安卓签名材料。丢失 = org.delector.app 这个包名永远无法再推送升级；
# 泄露 = 任何人都能签出冒充本 App 的更新包。CI 里 keystore 只解到
# $RUNNER_TEMP，本地请存在仓库之外（这几条是纵深防御的最后一层）。
*.jks
*.keystore
*.p12
*.jks.b64
signing.properties
keystore.properties

# IDE
.vscode/

# 本地 Claude Code 环境（hooks/settings/worktrees 均为本机 agent 工具配置，
# 不忽略的话，一次 `git add -A` 会把 hook 脚本与 settings 当普通文件提交进来）。
.claude/

# 临时调试脚本与开发沙盒（Scratchpad & Agent Caches）
scratch/
.workbuddy/

# vault-exec 执行状态机（会话态，不入库）
.vault-exec-ledger.json

# CodeBuddy 代理数据目录（记忆/会话态，不入库）
.codebuddy/

# WORKMEMORY/ 是跨 agent 共享工作记忆，MUST 入库随 git 同步（PROTOCOL §7），勿加入忽略规则。
agent/delector.exe
agent/coverage*

# 唯一例外：compact 现场快照由 PreCompact hook 自动追加（每次压缩一条，属工作态
# 而非共享状态），入库只会制造持续 diff 噪音。WORKMEMORY/ 其余文件仍 MUST 入库。
WORKMEMORY/session-snapshot.md
